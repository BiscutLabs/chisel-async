common --enable_bzlmod
build --java_runtime_version=remotejdk_21 --tool_java_runtime_version=remotejdk_21
build --java_language_version=21 --tool_java_language_version=21

# OpenROAD and Yosys from source, as bazel-orfs builds them.
build --incompatible_strict_action_env
build --features=external_include_paths
build --per_file_copt=.*external/.*@-w
build --host_per_file_copt=.*external/.*@-w
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build --@rules_python//python/config_settings:bootstrap_impl=script
common --lockfile_mode=off
