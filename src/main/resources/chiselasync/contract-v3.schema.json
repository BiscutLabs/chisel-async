        "view": {
          "enum": [
            "behavioral",
            "constraint-marker"
          ]
        },
        "version": {
          "const": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "timing": {
      "oneOf": [
        {
          "$ref": "#/$defs/captureTiming"
        },
        {
          "$ref": "#/$defs/longHoldTiming"
