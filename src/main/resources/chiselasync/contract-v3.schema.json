        "output_data": {
          "$ref": "#/$defs/id"
        },
        "output_control": {
          "$ref": "#/$defs/id"
        },
        "output_acknowledge": {
          "$ref": "#/$defs/id"
        },
        "cells": {
          "$ref": "#/$defs/delayBounds"
        },
        "data_delay": {
          "$ref": "#/$defs/delayBounds"
        },
        "matched_delay_fs": {
          "$ref": "#/$defs/time"
        },
        "return_delay_fs": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "qdiChannel": {
      "type": "object",
      "required": [
        "channel",
        "zero",
        "one",
        "acknowledge"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/id"
        },
        "zero": {
          "$ref": "#/$defs/id"
