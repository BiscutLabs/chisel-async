          "const": "0"
        },
        "budget": {
          "$ref": "#/$defs/delayBounds"
        },
        "delay_owner": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "delay_cell": {
          "$ref": "#/$defs/id"
        },
        "accounting": {
          "const": "included-in-delay-cell; replace-model-with-mapped-path; not-additive"
        }
      }
    },
    "longHoldFork": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "marker",
        "aout",
        "state_a",
        "early_pin",
        "late_pin",
        "relation",
        "model_wire_skew_fs",
        "a_min_fs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "long-hold-fork-v1"
        },
        "marker": {
          "$ref": "#/$defs/id"
        },
        "aout": {
          "$ref": "#/$defs/id"
        },
        "state_a": {
          "$ref": "#/$defs/id"
        },
        "early_pin": {
          "const": "long_hold.b"
        },
        "late_pin": {
          "const": "long_hold.a"
        },
        "relation": {
          "const": "Aout+ strictly before A- at OR inputs"
        },
        "model_wire_skew_fs": {
          "const": "0"
        },
        "a_min_fs": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "phaseTiming": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "marker",
        "direction",
        "cells",
        "return_delay_fs",
        "assumptions",
        "input_request",
        "input_acknowledge",
        "output_request",
        "output_acknowledge"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "phase-conversion-v2"
        },
        "marker": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "enum": [
            "two-to-four",
            "four-to-two"
          ]
        },
        "cells": {
          "$ref": "#/$defs/delayBounds"
        },
        "return_delay_fs": {
          "$ref": "#/$defs/time"
        },
        "assumptions": {
          "type": "string"
        },
        "input_request": {
          "$ref": "#/$defs/id"
        },
        "input_acknowledge": {
          "$ref": "#/$defs/id"
        },
        "output_request": {
          "$ref": "#/$defs/id"
        },
        "output_acknowledge": {
          "$ref": "#/$defs/id"
        },
        "history_closed": {
          "$ref": "#/$defs/id"
        },
        "history_closure": {
          "$ref": "#/$defs/delayBounds"
        },
        "request_delay_fs": {
          "$ref": "#/$defs/time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "four-to-two"
              }
            }
          },
          "then": {
            "required": [
              "history_closed",
              "history_closure",
              "request_delay_fs"
            ]
          }
        }
      ]
    },
    "encodingTiming": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "marker",
        "direction",
        "assumptions",
