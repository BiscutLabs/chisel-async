{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chisel-async:contract:v3",
  "title": "chisel-async typed-port and optimized read-probe export v3",
  "type": "object",
  "required": [
    "semantic_sha256",
    "manifest"
  ],
  "additionalProperties": false,
  "properties": {
    "semantic_sha256": {
      "$ref": "#/$defs/hash"
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema",
        "time_unit",
        "time_range",
        "top",
        "toolchain",
        "resources",
        "rtl_semantic_sha256",
        "design",
        "probe_abi",
        "port_abi"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "chisel-async-contract-v3"
        },
        "time_unit": {
          "const": "fs"
        },
        "time_range": {
          "const": "0..9223372036854775807"
        },
        "top": {
          "$ref": "#/$defs/id"
        },
        "toolchain": {
          "type": "object",
          "required": [
            "chisel",
            "scala",
            "firtool",
            "options"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        },
        "rtl_semantic_sha256": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        },
        "design": {
          "$ref": "#/$defs/node"
        },
        "probe_abi": {
          "type": "object",
          "required": [
            "file",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "port_abi": {
          "type": "object",
          "required": [
            "file",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "time": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Exact fs; validator additionally enforces signed 64-bit range."
    },
    "endpoint": {
      "type": "object",
      "required": [
        "id",
        "rtl_path",
        "width",
        "source",
        "probe"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rtl_path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "probe": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "channel": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "role",
            "reset_domain",
            "layout",
            "environment",
            "token_contract",
            "protocol",
            "phases",
            "request",
            "data",
            "acknowledge"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "role": {
              "enum": [
                "input",
                "output"
              ]
            },
            "reset_domain": {
              "$ref": "#/$defs/id"
            },
            "layout": {
              "type": "array",
              "minItems": 1
            },
            "environment": {
              "type": "string"
            },
            "token_contract": {
              "const": "ordered-lossless-reset-abort-v1"
            },
            "protocol": {
              "const": "four-phase-bundled-v1"
            },
            "phases": {
              "const": [
                "00",
                "10",
                "11",
                "01",
                "00"
              ]
            },
            "request": {
              "$ref": "#/$defs/id"
            },
            "data": {
              "$ref": "#/$defs/id"
            },
            "acknowledge": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "role",
            "reset_domain",
            "layout",
            "environment",
            "token_contract",
            "protocol",
            "phases",
            "zero",
            "one",
            "acknowledge"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "role": {
              "enum": [
                "input",
                "output"
              ]
            },
            "reset_domain": {
              "$ref": "#/$defs/id"
            },
            "layout": {
              "type": "array",
              "minItems": 1
            },
            "environment": {
              "type": "string"
            },
            "token_contract": {
              "const": "ordered-lossless-reset-abort-v1"
            },
            "protocol": {
              "const": "dual-rail-rtz-v1"
            },
            "phases": {
              "const": [
                "spacer",
                "data",
                "acknowledged",
                "spacer",
                "idle"
              ]
            },
            "zero": {
              "$ref": "#/$defs/id"
            },
            "one": {
              "$ref": "#/$defs/id"
            },
            "acknowledge": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "role",
            "reset_domain",
            "layout",
            "environment",
            "token_contract",
            "protocol",
            "phases",
            "valid",
            "data",
            "ready",
            "clock"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "role": {
              "enum": [
                "input",
                "output"
              ]
            },
            "reset_domain": {
              "$ref": "#/$defs/id"
            },
            "layout": {
              "type": "array",
              "minItems": 1
            },
            "environment": {
              "type": "string"
            },
            "token_contract": {
              "const": "ordered-lossless-reset-abort-v1"
            },
            "protocol": {
              "const": "decoupled-v1"
            },
            "phases": {
              "const": [
                "rising-edge-fire"
              ]
            },
            "valid": {
              "$ref": "#/$defs/id"
            },
            "data": {
              "$ref": "#/$defs/id"
            },
            "ready": {
              "$ref": "#/$defs/id"
            },
            "clock": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "role",
            "reset_domain",
            "layout",
            "environment",
            "token_contract",
            "protocol",
            "phases",
            "request",
            "data",
            "acknowledge"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "role": {
              "enum": [
                "input",
                "output"
              ]
            },
            "reset_domain": {
              "$ref": "#/$defs/id"
            },
            "layout": {
              "type": "array",
              "minItems": 1
            },
            "environment": {
              "type": "string"
            },
            "token_contract": {
              "const": "ordered-lossless-reset-abort-v1"
            },
            "protocol": {
              "const": "two-phase-bundled-v1"
            },
            "phases": {
              "const": [
                "00",
                "10",
                "11",
                "01",
                "00"
              ]
            },
            "request": {
              "$ref": "#/$defs/id"
            },
            "data": {
              "$ref": "#/$defs/id"
            },
            "acknowledge": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "primitive": {
      "type": "object",
      "required": [
        "id",
        "rtl_path",
        "model",
        "view",
        "version",
        "resource",
        "parameters",
        "reset",
        "reset_domain",
        "effects",
        "ports"
