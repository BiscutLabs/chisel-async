    "qdiTiming": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "marker",
        "indication",
        "component",
        "input_channels",
        "output_channels",
        "cells",
        "assumptions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "qdi-digital-v1"
        },
        "marker": {
          "$ref": "#/$defs/id"
        },
        "indication": {
          "enum": [
            "strong",
            "forwarding",
            "selected-strong"
          ]
        },
        "component": {
          "enum": [
            "storage",
            "dims",
            "fork",
            "join",
            "demux",
            "exclusive-merge"
          ]
        },
        "input_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/qdiChannel"
          }
        },
        "output_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/qdiChannel"
          }
        },
        "cells": {
          "$ref": "#/$defs/delayBounds"
        },
        "assumptions": {
          "type": "object",
          "required": [
            "cells",
            "forks",
            "reset",
            "rails",
            "exclusive_inputs"
          ],
          "additionalProperties": false,
          "properties": {
            "cells": {
              "const": "atomic-digital"
            },
            "forks": {
              "const": "ideal-zero-skew"
            },
            "reset": {
              "const": "coordinated-quiescent"
            },
            "rails": {
              "const": "monotonic-1-of-2-rtz"
