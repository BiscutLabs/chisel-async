    "longHoldTiming": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "mode",
        "request",
        "input_data",
        "latch_data",
        "latch_closed",
        "acknowledge",
        "output_request",
        "output_data",
        "matched_delay_fs",
        "output_delay_fs",
        "provenance",
        "assumptions",
        "data_delay",
        "latch_delay",
        "control_delays",
        "marker"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "long-hold-bundling-v2"
        },
        "mode": {
          "enum": [
            "functional-only",
            "digital-model"
          ]
        },
        "request": {
          "$ref": "#/$defs/id"
        },
        "input_data": {
          "$ref": "#/$defs/id"
        },
        "latch_data": {
          "$ref": "#/$defs/id"
        },
        "latch_closed": {
          "$ref": "#/$defs/id"
        },
        "acknowledge": {
          "$ref": "#/$defs/id"
        },
        "output_request": {
          "$ref": "#/$defs/id"
        },
        "output_data": {
          "$ref": "#/$defs/id"
        },
        "matched_delay_fs": {
          "$ref": "#/$defs/time"
        },
        "output_delay_fs": {
          "$ref": "#/$defs/time"
        },
        "provenance": {
          "type": "string"
        },
        "assumptions": {
          "type": "string"
        },
        "data_delay": {
          "$ref": "#/$defs/delayBounds"
        },
        "latch_delay": {
          "$ref": "#/$defs/delayBounds"
        },
        "control_delays": {
          "type": "object",
          "required": [
            "a",
            "b",
            "acknowledge",
            "long_hold"
          ],
          "additionalProperties": false,
          "properties": {
            "a": {
              "$ref": "#/$defs/delayBounds"
            },
            "b": {
              "$ref": "#/$defs/delayBounds"
            },
            "acknowledge": {
              "$ref": "#/$defs/delayBounds"
            },
            "long_hold": {
              "$ref": "#/$defs/delayBounds"
            }
          }
        },
        "marker": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "captureTiming": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "launch",
        "transaction",
        "data_valid",
        "capture",
        "captured",
        "setup_fs",
        "hold_fs",
        "mode",
        "provenance",
        "pulse_policy",
        "marker"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "bundled-setup-hold-v1"
        },
        "setup_fs": {
          "$ref": "#/$defs/time"
        },
        "hold_fs": {
          "$ref": "#/$defs/time"
        },
        "mode": {
          "const": "digital-model"
        },
        "marker": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "rtl_path",
        "module",
        "reset_domain",
        "capacity",
        "endpoints",
        "channels",
        "primitives",
        "timing",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "rtl_path": {
          "type": "string"
        },
        "module": {
          "$ref": "#/$defs/id"
        },
        "reset_domain": {
          "type": "string"
        },
        "capacity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
