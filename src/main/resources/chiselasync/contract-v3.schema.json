        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/primitive"
          }
        },
        "timing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timing"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "contract"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "contract": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      }
    },
    "delayBounds": {
      "type": "object",
      "required": [
        "min_fs",
        "max_fs",
        "model_fs"
      ],
      "additionalProperties": false,
      "properties": {
        "min_fs": {
          "$ref": "#/$defs/time"
        },
        "max_fs": {
          "$ref": "#/$defs/time"
        },
        "model_fs": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "dataPathTiming": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "marker",
        "source",
        "sink",
        "logic",
        "logic_model_fs",
        "budget",
        "delay_owner",
        "delay_cell",
        "accounting"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "bundled-data-path-v1"
        },
        "marker": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "sink": {
          "$ref": "#/$defs/id"
        },
        "logic": {
          "enum": [
            "chisel-transform-including-decode",
            "exclusive-merge-input-mux",
            "initial-token-literal-mux"
          ]
        },
