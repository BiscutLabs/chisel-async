        },
        "assumptions": {
          "type": "string"
        },
        "input_data": {
          "$ref": "#/$defs/id"
        },
        "input_control": {
          "$ref": "#/$defs/id"
        },
        "input_acknowledge": {
          "$ref": "#/$defs/id"
