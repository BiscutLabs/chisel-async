"""chisel-async: Bazel build beside sbt.

The library, its tests and the quickstart examples build with the same
Chisel 7.16.0 / Scala 2.13.18 / firtool 1.160.0 tuple as build.sbt and the
README compatibility matrix. The physical flow (bazel-orfs: Yosys, OpenROAD,
the asap7 PDK) is fetched lazily: building //:chisel_async never downloads it.
"""

module(name = "chisel_async")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_scala", version = "7.4.0")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.13.18")
use_repo(scala_config, "rules_scala_config")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
scala_deps.scalatest()
use_repo(scala_deps, "rules_scala_toolchains")

# The same artifacts as build.sbt's libraryDependencies and compiler plugin.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.chipsalliance:chisel_2.13:7.16.0",
        "org.chipsalliance:chisel-plugin_2.13.18:7.16.0",
        "com.lihaoyi:ujson_2.13:3.3.1",
        "org.scalatest:scalatest_2.13:3.2.20",
    ],
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")

# firtool, the version ExportDesign qualifies. A release binary, so neither a
# JDK nor firtool-resolver has to run on the host to fetch it.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "firtool",
    build_file_content = """exports_files(["bin/firtool"], visibility = ["//visibility:public"])""",
    sha256 = "bc0a09658f7aee5359997468a1aa100d8851ee0c2f0caac3708e0c95451acbed",
    strip_prefix = "firtool-1.160.0",
    urls = ["https://github.com/llvm/circt/releases/download/firtool-1.160.0/firrtl-bin-linux-x64.tar.gz"],
)

# Root-only overrides for building OpenROAD and Yosys from source, mirrored from
# bazel-orfs's own MODULE.bazel: Bazel honours these only in the root module.
# The hermetic LLVM toolchain means no host compiler is needed. The four
# patches in bazel/patches are bazel-orfs's, each with its reason in its header.
single_version_override(
    module_name = "yosys",
    patch_strip = 1,
    patches = [
        "//bazel/patches:yosys-0001-aiger2-holes-output-order.patch",
        "//bazel/patches:yosys-0002-abc-new-script-option.patch",
    ],
)

single_version_override(
    module_name = "sv-lang",
    version = "10.0.1-20260316-f04e8156",
)

single_version_override(
    module_name = "sed",
    version = "4.9.bcr.5",
)

single_version_override(
    module_name = "bison",
    patch_strip = 1,
    patches = [
        "//bazel/patches:0001-gnulib-wrapper-headers-use-I-not-isystem.patch",
    ],
    version = "3.8.2.bcr.7",
)

single_version_override(
    module_name = "boost.icl",
    patch_strip = 1,
    patches = [
        "//bazel/patches:0001-refactor-interval-lookup-operations-icl-54.patch",
    ],
)

single_version_override(
    module_name = "rules_flex",
    version = "0.4",
)

single_version_override(
    module_name = "scip",
    version = "9.2.3.bcr.1",
)

single_version_override(
    module_name = "rules_bison",
    version = "0.4.bcr.1",
)

single_version_override(
    module_name = "gawk",
    version = "5.3.2.bcr.7",
)

single_version_override(
    module_name = "m4",
    version = "1.4.21.bcr.4",
)

bazel_dep(name = "rules_pycross", version = "0.8.3")

pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross")

pycross.configure_environments(python_versions = ["3.13"])

bazel_dep(name = "llvm", version = "0.8.18")

single_version_override(
    module_name = "llvm",
    version = "0.8.18",
)

register_toolchains("@llvm//toolchain:all")

single_version_override(
    module_name = "apple_support",
    version = "1.24.2",
)

single_version_override(
    module_name = "flex",
    version = "2.6.4.bcr.5",
)

single_version_override(
    module_name = "fmt",
    version = "12.1.0",
)

single_version_override(
    module_name = "rules_cc",
    version = "0.2.22",
)

single_version_override(
    module_name = "rules_cc_autoconf",
    version = "0.13.2",
)

single_version_override(
    module_name = "yaml-cpp",
    version = "0.9.0",
)

single_version_override(
    module_name = "zlib",
    version = "1.3.1.bcr.8",
)

bazel_dep(
    name = "rules_python",
    version = "2.3.2",
)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)

python.toolchain(
    is_default = True,
    python_version = "3.13",
)


# The physical flow: bazel-orfs (Yosys, OpenROAD, OpenROAD-flow-scripts and
# its PDKs, among them asap7 and gf180). `bazelisk run @bazel-orfs//:bump`
# keeps these pins current.
bazel_dep(name = "bazel-orfs")
git_override(
    module_name = "bazel-orfs",
    commit = "b02fde1149a9fe319c7b21b1209f6525280795d4",
    remote = "https://github.com/The-OpenROAD-Project/bazel-orfs.git",
)

# OpenROAD at the commit bazel-orfs b02fde11 pins, built from source. The two
# patch_cmds are bazel-orfs's build fixes for that commit (slang from BCR's
# sv-lang, fmt in the elaborator).
bazel_dep(name = "openroad")
git_override(
    module_name = "openroad",
    commit = "a3bf6124782f205ba5fa9e2e402dae8b665fc4fc",
    init_submodules = True,
    patch_cmds = [
        "find . -name BUILD -exec sed -i 's|\"@slang\"|\"@sv-lang//:libsvlang\"|g' {} +",
        "sed -i 's|defines = \\[|copts = [\"-include\", \"fmt/format.h\"],\\n    defines = [|' src/syn/src/elab/BUILD third-party/slang-elab/src/BUILD",
    ],
    remote = "https://github.com/The-OpenROAD-Project/OpenROAD.git",
)

bazel_dep(name = "qt-bazel")
git_override(
    module_name = "qt-bazel",
    commit = "c3319f9e7735c67d47c7dfcc4a135bb91080f1a3",
    remote = "https://github.com/The-OpenROAD-Project/qt_bazel_prebuilts",
)

bazel_dep(name = "sv-elab", version = "2026-07-07")
bazel_dep(name = "yosys", version = "0.68.bcr.1")

orfs = use_extension("@bazel-orfs//:extension.bzl", "orfs_repositories")
orfs.source(
    commit = "3451ca1f56902a49baf50bb8eba345eb709cf9c8",
    integrity = "sha256-Ldu/46K/KRwtBkiyMlFNX28oHJbRjUPu9Z7vn5/0/Xk=",
    # Carried until ORFS has it; each patch says why and how it retires.
    patches = ["//bazel/patches:0001-orfs-gf180-7t-adder-and-latch-maps.patch"],
)
orfs.default(
    yosys_plugins = ["@sv-elab//src/yosys_plugin:slang.so"],
)
use_repo(orfs, "gnumake", "orfs")
